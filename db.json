  "blogs": [
    {
      "id": "blog_1",
      "title": "Why Kids Need to Learn Prompt Engineering in 2026",
      "content": "Prompt engineering is not just for software engineers anymore. In today's AI-centric world, the ability to clearly direct artificial intelligence is becoming a core literacy skill. At AI Smart Kids, we teach children how to write structured prompts, iterate on AI responses, and break down complex projects into granular tasks.\n\n### Why it matters:\n1. **Critical Thinking**: To guide an AI, a student must first understand what they want to achieve and how to describe it logicially.\n2. **Immediate Feedback**: Testing prompts provides instant results, encouraging exploration and learning from failure.\n3. **Empowerment**: Kids transition from being consumers of technology to creators who leverage AI to bring their imaginations to life.",
      "excerpt": "Discover why prompt engineering is the new fundamental skill for the modern generation and how children in Ujjain are learning to co-create with AI.",
      "category": "Education",
      "featuredImage": "/images/blog_prompt.jpg",
      "seoTitle": "Learn Prompt Engineering for Kids | AI Smart Kids Ujjain",
      "seoDescription": "Prompt engineering is a critical future literacy. Find out how children age 9-16 learn to command ChatGPT, Claude, and Midjourney to build cool projects.",
      "status": "Published",
      "publishedAt": "2026-06-20T12:00:00.000Z"
    },
    {
      "id": "blog_2",
      "title": "Introducing Ujjain's First Dedicated AI Institute for Kids",
      "content": "Ujjain is a city of heritage, and now it becomes a hub for futuristic learning! AI Smart Kids is officially open in the heart of Ujjain, offering kids a direct gateway to cutting-edge tools like ChatGPT, Midjourney, Cursor, and Canva.\n\nOur classroom features futuristic 3D workspaces, small batch sizes capped at 12 students, and a 100% practical, project-based curriculum where kids build actual websites, write code, create generative art, and compile their own portfolios.",
      "excerpt": "We are proud to announce the launch of AI Smart Kids in Ujjain. Read about our mission to equip children with essential AI and tech skills.",
      "category": "Announcement",
      "featuredImage": "/images/blog_launch.jpg",
      "seoTitle": "First AI Institute for Kids in Ujjain | AI Smart Kids",
      "seoDescription": "AI Smart Kids opens in Ujjain! We provide premium, practical, project-based AI training for kids aged 9-16. Join us for a free demo session.",
      "status": "Published",
      "publishedAt": "2026-06-25T09:00:00.000Z"
    }
  ],
